{
    "name": "sajawd-yq/eloquent-sluggable-persian",
    "description": "Easy creation of slugs for your Eloquent models in Laravel",
    "keywords": [
        "eloquent-sluggable",
        "eloquent",
        "sluggable",
        "laravel",
        "lumen",
        "slug"
    ],
    "homepage": "https://github.com/sajawd-yq/eloquent-sluggable-persian.git",
    "license": "MIT",
    "authors": [
        {
            "name": "sajad yq",
            "email": "sajad.yq79@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "cocur/slugify": "^4.3",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cviebrock\\EloquentSluggable\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cviebrock\\EloquentSluggable\\Tests\\": "tests"
        }
    },
    "scripts": {
        "fresh": [
            "rm -rf vendor composer.lock",
            "composer install"
        ],
        "tests": [
            "php vendor/bin/pest --no-coverage"
        ],
        "tests:coverage": [
            "php -d xdebug.mode=coverage vendor/bin/pest --coverage"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cviebrock\\EloquentSluggable\\ServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
